      "customfield_10034": {
        "type": "doc",
        "version": 1,
        "content": [
          {
            "type": "bulletList",
            "content": [
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Given a booking request where checkout is before checkin, when POST /booking is called, then the API returns 400 with code DATE_RANGE_INVALID."
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Given a booking request where checkout equals checkin, when POST /booking is called, then the API returns 400 with code DATE_RANGE_ZERO."
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Given a valid date range, when POST /booking is called, then the booking is created and returns 201."
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Given an existing booking, when PATCH /booking/{id} sets an invalid range, then the API returns 400 and the booking is unchanged."
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    },
