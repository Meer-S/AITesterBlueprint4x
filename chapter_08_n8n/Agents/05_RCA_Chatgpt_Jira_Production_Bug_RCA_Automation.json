    },
    {
      "parameters": {
        "jsCode": "return [{json:{status:'skipped',reason:'Ticket no longer matches the production-bug JQL.',jira_key:$('Normalize Jira Event').first().json.jira_key}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
