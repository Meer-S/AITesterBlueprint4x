      ],
      "id": "6aa69179-d2cc-4d98-a754-422c1b1e1216",
      "name": "AI Agent - Generate RCA"
    },
    {
      "parameters": {
        "modelName": "={{ $('Workflow Configuration').first().json.AI_MODEL }}",
        "options": {
          "temperature": 0.1
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
