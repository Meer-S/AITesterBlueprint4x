      ],
      "id": "4484628d-8893-4dcc-af55-079027a1e2a1",
      "name": "Jira - Get Comments"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Workflow Configuration').first().json.JIRA_BASE_URL + '/rest/api/3/search/jql' }}",
        "authentication": "predefinedCredentialType",
