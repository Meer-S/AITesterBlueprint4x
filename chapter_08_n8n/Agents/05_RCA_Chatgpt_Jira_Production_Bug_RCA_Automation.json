    {
      "parameters": {
        "jsCode": "\nconst d = $('Check Duplicate and Version').first().json;\nif (!$json.id) throw new Error('Google Drive copy response did not include a file ID.');\nreturn [{ json: {\n  spreadsheet_id: $json.id,\n  sheet_url: $json.webViewLink || ('https://docs.google.com/spreadsheets/d/' + $json.id),\n  rca_version: d.existing_version + 1,\n  workbook_mode: 'created'\n} }];"
