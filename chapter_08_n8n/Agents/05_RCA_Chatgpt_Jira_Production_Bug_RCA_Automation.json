      ],
      "id": "3331e9aa-917a-483e-8b02-08989878f3bc",
      "name": "Jira - Verify Production JQL"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
