    {
      "parameters": {
        "jsCode": "\nconst workbook = $json;\nconst validated = $('Validate RCA JSON').first().json;\nconst r = validated.rca;\nconst m = r.metadata;\nconst a = r.assessment;\nconst asText = v => Array.isArray(v) ? v.join('\\n') : (v ?? '');\nconst rowValues = (items, columns) => (items ?? []).map(item => columns.map(c => asText(item[c])));\nconst data = [\n  { range: \"'RCA Summary'!B6\", values: [[m.jira_key]] },\n  { range: \"'RCA Summary'!D6\", values: [[m.issue_type]] },\n  { range: \"'RCA Summary'!F6\", values: [[m.jira_status]] },\n  { range: \"'RCA Summary'!H6\", values: [[m.jira_priority]] },\n  { range: \"'RCA Summary'!B7\", values: [[m.project]] },\n  { range: \"'RCA Summary'!E7\", values: [[m.reporter]] },\n  { range: \"'RCA Summary'!G7\", values: [[m.assignee]] },\n  { range: \"'RCA Summary'!B8\", values: [[m.created_at]] },\n  { range: \"'RCA Summary'!E8\", values: [[m.updated_at]] },\n  { range: \"'RCA Summary'!H8\", values: [[m.resolution]] },\n  { range: \"'RCA Summary'!B9\", values: [[m.title]] },\n  { range: \"'RCA Summary'!B10\", values: [[m.url]] },\n  { range: \"'RCA Summary'!B11\", values: [['Jira API | n8n execution ' + validated.audit.execution_id + ' | RCA v' + workbook.rca_version]] },\n  { range: \"'RCA Summary'!B14\", values: [[a.problem_statement]] },\n  { range: \"'RCA Summary'!B16\", values: [[a.observed_symptom]] },\n  { range: \"'RCA Summary'!B18\", values: [[a.business_impact]] },\n  { range: \"'RCA Summary'!B20\", values: [[a.technical_impact]] },\n  { range: \"'RCA Summary'!B22\", values: [[a.detection_method]] },\n  { range: \"'RCA Summary'!B24\", values: [[a.rca_status]] },\n  { range: \"'RCA Summary'!E24\", values: [[a.confidence]] },\n  { range: \"'RCA Summary'!G24\", values: [[a.recommended_severity]] },\n  { range: \"'RCA Summary'!B25\", values: [[a.direct_cause]] },\n  { range: \"'RCA Summary'!B27\", values: [[a.root_cause]] },\n  { range: \"'RCA Summary'!B29\", values: [[asText(a.contributing_factors)]] },\n  { range: \"'RCA Summary'!B31\", values: [[asText(a.evidence_required)]] },\n  { range: \"'RCA Summary'!B37\", values: [[a.immediate_containment]] },\n  { range: \"'RCA Summary'!B39\", values: [[a.corrective_direction]] },\n  { range: \"'RCA Summary'!B41\", values: [[a.preventive_direction]] },\n  { range: \"'RCA Summary'!B44\", values: [[a.validation_plan]] },\n  { range: \"'RCA Summary'!H49\", values: [[a.rca_owner || 'TBD']] }\n];\nconst fiveWhys = rowValues(r.five_whys, ['why_level','question','answer','evidence','gap_or_next_question','owner','status']);\nconst timeline = rowValues(r.timeline, ['timestamp','event','evidence','impact','owner','notes']);\nconst actions = rowValues(r.actions, ['action_id','action_type','description','owner','priority','due_date','status','success_measure']);\nconst evidence = rowValues(r.evidence, ['evidence_id','source','timestamp','observation','supports_or_refutes','link_or_reference','owner']);\nconst validation = rowValues(r.validation, ['validation_id','fix_or_hypothesis','test_method','expected_result','owner','status']);\nif (fiveWhys.length) data.push({ range: \"'5 Whys'!A2:G\" + (fiveWhys.length + 1), values: fiveWhys });\nif (timeline.length) data.push({ range: \"'Timeline'!A2:F\" + (timeline.length + 1), values: timeline });\nif (actions.length) data.push({ range: \"'Actions'!A2:H\" + (actions.length + 1), values: actions });\nif (evidence.length) data.push({ range: \"'Evidence & Validation'!A2:G\" + (evidence.length + 1), values: evidence });\nif (validation.length) data.push({ range: \"'Evidence & Validation'!A11:F\" + (validation.length + 10), values: validation });\nreturn [{ json: {\n  ...workbook,\n  jira_key: m.jira_key,\n  fingerprint: validated.audit.fingerprint,\n  jira_updated_at: validated.audit.jira_updated_at,\n  generated_at: validated.audit.generated_at,\n  execution_id: validated.audit.execution_id,\n  xlsx_filename: 'RCA_' + m.jira_key + '_v' + workbook.rca_version + '.xlsx',\n  clear_body: { ranges: [\n    \"'5 Whys'!A2:G100\",\n    \"'Timeline'!A2:F100\",\n    \"'Actions'!A2:H100\",\n    \"'Evidence & Validation'!A2:G100\",\n    \"'Evidence & Validation'!A11:F100\"\n  ] },\n  batch_update_body: { valueInputOption: 'USER_ENTERED', data }\n} }];"
      },
