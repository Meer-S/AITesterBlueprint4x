    },
    {
      "parameters": {
        "jiraVersion": "cloud",
        "events": [
          "jira:issue_created",
          "jira:issue_updated"
        ],
        "authenticateWebhook": false,
        "additionalFields": {
          "filter": "project = VWO AND issuetype = Bug AND labels = \"production-bug\" AND statusCategory != Done"
        }
      },
      "type": "n8n-nodes-base.jiraTrigger",
      "typeVersion": 1.1,
      "position": [
        -1140,
        40
      ],
      "id": "27a7466d-c512-4bd8-8d7d-e79f9b65409c",
      "name": "Jira Trigger - Production Bug"
    },
    {
      "parameters": {
        "jsCode": "\nconst CONFIG = {\n  JIRA_BASE_URL: 'https://YOUR-DOMAIN.atlassian.net',\n  PRODUCTION_BUG_JQL: 'project = VWO AND issuetype = Bug AND labels = \"production-bug\" AND statusCategory != Done',\n  RCA_TEMPLATE_FILE_ID: 'REPLACE_WITH_NATIVE_GOOGLE_SHEET_TEMPLATE_FILE_ID',\n  RCA_GOOGLE_SHEETS_FOLDER_ID: 'REPLACE_WITH_GOOGLE_SHEETS_OUTPUT_FOLDER_ID',\n  RCA_EXCEL_FOLDER_ID: 'REPLACE_WITH_EXCEL_OUTPUT_FOLDER_ID',\n  AUDIT_SPREADSHEET_ID: 'REPLACE_WITH_AUDIT_SPREADSHEET_ID',\n  AI_MODEL: 'gpt-4.1-mini'\n};\nreturn items.map(item => ({ json: { ...item.json, ...CONFIG } }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -620,
        120
      ],
      "id": "a6d286b1-4f62-4fa0-a1a6-5e46838c196f",
      "name": "Workflow Configuration"
    },
    {
      "parameters": {
        "jsCode": "\nconst src = $json;\nconst issue = src.issue ?? src;\nconst key = issue.key ?? src.issueKey ?? src.key ?? 'VWO-49';\nif (!key) throw new Error('The Jira event did not contain an issue key.');\nreturn [{ json: {\n  jira_key: key,\n  webhook_event: src.webhookEvent ?? src.event ?? 'manual_test',\n  event_timestamp: src.timestamp ?? new Date().toISOString()\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -380,
        120
      ],
      "id": "efd66472-5ba0-472c-9bb2-467356f6fb3e",
      "name": "Normalize Jira Event"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Workflow Configuration').first().json.JIRA_BASE_URL + '/rest/api/3/issue/' + $json.jira_key }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "jiraSoftwareCloudApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "expand",
              "value": "changelog"
            },
            {
              "name": "fields",
              "value": "*all"
            }
          ]
        },
        "options": {
