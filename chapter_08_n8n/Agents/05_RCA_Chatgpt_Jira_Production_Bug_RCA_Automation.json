      "id": "4de10ed7-5892-49b7-9671-e56c8b89595c",
      "name": "OpenAI Chat Model"
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"metadata\",\"assessment\",\"five_whys\",\"timeline\",\"actions\",\"evidence\",\"validation\",\"quality_checks\"],\"properties\":{\"metadata\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"jira_key\",\"url\",\"title\",\"project\",\"issue_type\",\"jira_status\",\"jira_priority\",\"reporter\",\"assignee\",\"created_at\",\"updated_at\",\"resolution\",\"rca_generated_at\",\"rca_version\"],\"properties\":{\"jira_key\":{\"type\":\"string\"},\"url\":{\"type\":\"string\"},\"title\":{\"type\":\"string\"},\"project\":{\"type\":\"string\"},\"issue_type\":{\"type\":\"string\"},\"jira_status\":{\"type\":\"string\"},\"jira_priority\":{\"type\":\"string\"},\"reporter\":{\"type\":\"string\"},\"assignee\":{\"type\":\"string\"},\"created_at\":{\"type\":\"string\"},\"updated_at\":{\"type\":\"string\"},\"resolution\":{\"type\":\"string\"},\"rca_generated_at\":{\"type\":\"string\"},\"rca_version\":{\"type\":\"integer\"}}},\"assessment\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"problem_statement\",\"observed_symptom\",\"business_impact\",\"technical_impact\",\"detection_method\",\"rca_status\",\"confidence\",\"recommended_severity\",\"recommended_priority\",\"direct_cause\",\"root_cause\",\"contributing_factors\",\"evidence_required\",\"immediate_containment\",\"corrective_direction\",\"preventive_direction\",\"validation_plan\",\"rca_owner\"],\"properties\":{\"problem_statement\":{\"type\":\"string\"},\"observed_symptom\":{\"type\":\"string\"},\"business_impact\":{\"type\":\"string\"},\"technical_impact\":{\"type\":\"string\"},\"detection_method\":{\"type\":\"string\"},\"rca_status\":{\"type\":\"string\"},\"confidence\":{\"type\":\"string\"},\"recommended_severity\":{\"type\":\"string\"},\"recommended_priority\":{\"type\":\"string\"},\"direct_cause\":{\"type\":\"string\"},\"root_cause\":{\"type\":\"string\"},\"immediate_containment\":{\"type\":\"string\"},\"corrective_direction\":{\"type\":\"string\"},\"preventive_direction\":{\"type\":\"string\"},\"validation_plan\":{\"type\":\"string\"},\"rca_owner\":{\"type\":\"string\"},\"contributing_factors\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"evidence_required\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}}},\"five_whys\":{\"type\":\"array\",\"maxItems\":5,\"items\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"why_level\",\"question\",\"answer\",\"evidence\",\"gap_or_next_question\",\"owner\",\"status\"],\"properties\":{\"why_level\":{\"type\":\"integer\"},\"question\":{\"type\":\"string\"},\"answer\":{\"type\":\"string\"},\"evidence\":{\"type\":\"string\"},\"gap_or_next_question\":{\"type\":\"string\"},\"owner\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"}}}},\"timeline\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"timestamp\",\"event\",\"evidence\",\"impact\",\"owner\",\"notes\"],\"properties\":{\"timestamp\":{\"type\":\"string\"},\"event\":{\"type\":\"string\"},\"evidence\":{\"type\":\"string\"},\"impact\":{\"type\":\"string\"},\"owner\":{\"type\":\"string\"},\"notes\":{\"type\":\"string\"}}}},\"actions\":{\"type\":\"array\",\"maxItems\":10,\"items\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"action_id\",\"action_type\",\"description\",\"owner\",\"priority\",\"due_date\",\"status\",\"success_measure\"],\"properties\":{\"action_id\":{\"type\":\"string\"},\"action_type\":{\"type\":\"string\"},\"description\":{\"type\":\"string\"},\"owner\":{\"type\":\"string\"},\"priority\":{\"type\":\"string\"},\"due_date\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"success_measure\":{\"type\":\"string\"}}}},\"evidence\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"evidence_id\",\"source\",\"timestamp\",\"observation\",\"supports_or_refutes\",\"link_or_reference\",\"owner\"],\"properties\":{\"evidence_id\":{\"type\":\"string\"},\"source\":{\"type\":\"string\"},\"timestamp\":{\"type\":\"string\"},\"observation\":{\"type\":\"string\"},\"supports_or_refutes\":{\"type\":\"string\"},\"link_or_reference\":{\"type\":\"string\"},\"owner\":{\"type\":\"string\"}}}},\"validation\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"validation_id\",\"fix_or_hypothesis\",\"test_method\",\"expected_result\",\"owner\",\"status\"],\"properties\":{\"validation_id\":{\"type\":\"string\"},\"fix_or_hypothesis\":{\"type\":\"string\"},\"test_method\":{\"type\":\"string\"},\"expected_result\":{\"type\":\"string\"},\"owner\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"}}}},\"quality_checks\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"root_cause_supported_by_evidence\",\"missing_information_disclosed\",\"contains_invented_facts\",\"requires_human_review\"],\"properties\":{\"root_cause_supported_by_evidence\":{\"type\":\"boolean\"},\"missing_information_disclosed\":{\"type\":\"boolean\"},\"contains_invented_facts\":{\"type\":\"boolean\"},\"requires_human_review\":{\"type\":\"boolean\"}}}}}",
        "autoFix": false
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        2100,
        160
      ],
      "id": "8afa38bf-70a2-4064-86fb-409ae4818527",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "jsCode": "\nlet rca = $json.output ?? $json;\nif (typeof rca === 'string') {\n  try { rca = JSON.parse(rca); } catch (e) { throw new Error('AI output was not valid JSON: ' + e.message); }\n}\nconst source = $('Build Jira Evidence Package').first().json;\nconst errors = [];\nif (!rca || typeof rca !== 'object') errors.push('RCA is not an object.');\nif (rca?.metadata?.jira_key !== source.issue.key) errors.push('Jira key does not match the source ticket.');\nif (!rca?.assessment) errors.push('assessment is missing.');\nif (!Array.isArray(rca?.five_whys) || rca.five_whys.length > 5) errors.push('five_whys must contain 0-5 rows.');\nif (!Array.isArray(rca?.actions) || rca.actions.length > 10) errors.push('actions must contain 0-10 rows.');\nif (rca?.quality_checks?.contains_invented_facts === true) errors.push('The model flagged invented facts.');\nif (rca?.quality_checks?.root_cause_supported_by_evidence === false) {\n  const root = String(rca?.assessment?.root_cause ?? '').toLowerCase();\n  if (root && !root.includes('not determined') && !root.includes('unconfirmed')) {\n    errors.push('Unsupported root cause must be labeled Not determined or Unconfirmed.');\n  }\n}\nreturn [{ json: {\n  valid: errors.length === 0,\n  validation_errors: errors,\n  rca,\n  audit: {\n    jira_key: source.issue.key,\n    fingerprint: source.processing.fingerprint,\n    jira_updated_at: source.issue.updated_at,\n    proposed_version: source.processing.proposed_version,\n    generated_at: source.processing.generated_at,\n    execution_id: source.processing.execution_id\n  }\n} }];"
      },
